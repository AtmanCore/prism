# PRism: every key lives here. Copy to .env and fill in.
# All values are passed to the gh / git / claude subprocesses the service runs.

# GitHub token used to find and read PRs, and to post comments / approve PRs when you confirm it in the UI.
# If empty, the service falls back to your `gh auth` login. `./setup.sh` creates it for you.
# Recommended: a fine-grained token for your org(s) with Contents: Read, Metadata: Read, Issues: Read,
# and Pull requests: Read and write (or Read only, if you won't post or approve from PRism). It can't push or merge.
GITHUB_TOKEN=

# Docker only: your Claude subscription inside the container. Run `claude setup-token` on your host
# and paste the token here. Natively, leave it empty: your logged-in Claude Code account is used.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional: Anthropic API key for `claude -p`. Leave empty to use your logged-in Claude Code account.
ANTHROPIC_API_KEY=

# Docker only: Jira and Confluence (read-only). Create an API token at
# https://id.atlassian.com/manage-profile/security/api-tokens (it acts as you, so reviews can read what
# you can read). The container runs the Atlassian MCP server in read-only mode with only
# get/search tools enabled. Natively, use your own Claude Code MCP setup instead (see README).
JIRA_URL=
JIRA_USERNAME=
JIRA_API_TOKEN=
CONFLUENCE_URL=
CONFLUENCE_USERNAME=
CONFLUENCE_API_TOKEN=

# Optional: port override (default 6161)
PR_REVIEW_PORT=6161
